# --- Qloo (server-side only; never sent to the browser) ---
# Leave empty to run in clearly-labelled SAMPLE DATA mode.
QLOO_API_KEY=
# Hackathon keys use hackathon.api.qloo.com; production keys use https://api.qloo.com
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Max Qloo requests per second and concurrent requests (rate-limit friendliness)
QLOO_RPS=8
QLOO_CONCURRENCY=6
# Cache TTL (seconds) for Qloo responses. Optional persistent cache dir for local/Render disks.
QLOO_CACHE_TTL=21600
# QLOO_CACHE_DIR=.qloo-cache

# --- Optional LLM (narration, anchor rewriting, "Without Qloo" baseline) ---
# Provide ONE of these. Without any, deterministic templates are used and the baseline is a popularity-only stand-in.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

PORT=3000
